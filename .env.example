# Local Flutter and safety-tracker configuration.
# Copy to .env and replace the placeholders. Never commit the real .env file.
# SUPABASE_ANON_KEY is a public client key; never use a service_role key here.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anonymous_key_here
SAFETY_TRACKER_URL=https://alphasimpli.github.io/AlonzY/track.html
